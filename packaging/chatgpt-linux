#!/usr/bin/env bash
set -euo pipefail

export ELECTRON_OZONE_PLATFORM_HINT=${ELECTRON_OZONE_PLATFORM_HINT:-auto}
export ELECTRON_ENABLE_LOGGING=${ELECTRON_ENABLE_LOGGING:-0}
export CODEX_ELECTRON_ENABLE_LINUX_COMPUTER_USE=${CODEX_ELECTRON_ENABLE_LINUX_COMPUTER_USE:-1}

args=()
for argument in "$@"; do
  if [[ "$argument" == file://* ]]; then
    args+=("${argument#file://}")
  else
    args+=("$argument")
  fi
done

exec /opt/chatgpt-linux/chatgpt "${args[@]}"
